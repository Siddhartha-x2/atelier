# Required only when creating the studio account during the first seed.
# Replace this placeholder with your own password. Never commit the real .env.
STUDIO_PASSWORD=<choose-a-10-to-128-character-password>

# Optional settings: uncomment and replace a placeholder to override its default.
# PORT=<port-number-default-3000>
# HOST=<bind-address-default-127.0.0.1>
# DATABASE_PATH=<private-db-path-default-data/art-studio.sqlite>
# APP_ORIGIN=<exact-browser-origin-default-http://localhost:3000>
# COOKIE_SECURE=<false-for-localhost-true-for-https>
# SESSION_HOURS=<session-duration-default-12>
