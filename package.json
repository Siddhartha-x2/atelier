{
  "name": "art-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Art Studio \u2014 HTML, CSS and plain JavaScript frontend with Express and SQLite",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 test/integration.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "express": "5.1.0"
  }
}
